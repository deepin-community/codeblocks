-                                            + wxT(__TIME__) + wxT(" - ")
+    const wxString AppBuildTimestamp     = (  wxString(wxT(BUILD_DATE)) + wxT(", ")
+                                            + wxT(BUILD_TIME) + wxT(" - ")
                                             + wxVERSION_STRING
 #if defined(__clang__)
                                             + wxString::Format(wxT(" - clang %d.%d.%d"),
